APP_NAME="OCI Limit Intelligence Platform"
ENVIRONMENT=production
DATABASE_URL=postgresql+psycopg://lip:change-me@postgres:5432/lip
CORS_ORIGINS=["https://lip.example.com"]

OCI_AUTH_MODE=instance_principal
OCI_TENANCY_OCID=ocid1.tenancy.oc1..aaaaaaaa5trur7whdyytam4nmh3tinrx2yfqnbss6yzz4q6i7gmm2leagnkq
OCI_DEFAULT_REGION=us-ashburn-1
OCI_SCAN_ALL_REGIONS=false
OCI_CONNECT_TIMEOUT_SECONDS=10
OCI_READ_TIMEOUT_SECONDS=45
OCI_MAX_SERVICE_WORKERS=6
OCI_MAX_LIMIT_WORKERS=10
OCI_DB_COMMIT_BATCH_SIZE=25

WARNING_THRESHOLD_PERCENT=90
CRITICAL_THRESHOLD_PERCENT=98
TREND_ALERT_WINDOW_DAYS=14

LIP_ENABLE_SCHEDULER=false
LIP_SCAN_INTERVAL_MINUTES=60
LIP_ENABLE_NOTIFICATIONS=false
LIP_NOTIFICATION_TOPIC_NAME=oci-lip-limit-alerts
LIP_NOTIFICATION_COMPARTMENT_OCID=
LIP_NOTIFICATION_EMAILS=["grant.frost@oracle.com"]

UPLOAD_DIR=/var/lib/oci-lip/uploads
UPLOAD_MAX_BYTES=26214400
