#cloud-config
package_update: true
packages: [curl, dnf-plugins-core, git, openssl, python3, python3-pip]
write_files:
  - path: /etc/oci-lip/config.json
    permissions: '0600'
    encoding: b64
    content: ${config}
  - path: /usr/local/lib/oci-lip/bootstrap.py
    permissions: '0700'
    encoding: b64
    content: ${bootstrap}
  - path: /usr/local/sbin/oci-lip-install
    permissions: '0700'
    encoding: b64
    content: ${install}
  - path: /usr/local/sbin/oci-lip-ready
    permissions: '0700'
    encoding: b64
    content: ${ready}
  - path: /etc/systemd/system/oci-lip.service
    permissions: '0644'
    encoding: b64
    content: ${service}
runcmd:
  - [/usr/local/sbin/oci-lip-install]
